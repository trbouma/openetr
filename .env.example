# Copy this file to .env for a standalone container deployment.
OPENETR_IMAGE=openetr-web:local
OPENETR_BIND_ADDRESS=127.0.0.1
OPENETR_PORT=8000

# Generate with: openssl rand -hex 32
OPENETR_APP_SESSION_SECRET=

# Optional public and protocol configuration.
# OPENETR_PUBLIC_BASE_URL=https://openetr.example.org
# OPENETR_ROOT_NSEC=
# OPENETR_HOME_RELAYS=wss://relay.example.org
# OPENETR_BLOSSOM_SERVER=https://blossom.example.org
# OPENETR_MAX_UPLOAD_BYTES=10485760
# OPENETR_GIT_COMMIT=unknown
