# Copy this file to .env for a standalone container deployment.
OPENETR_IMAGE=openetr-web:local
OPENETR_BIND_ADDRESS=127.0.0.1
OPENETR_PORT=8000

# Generate with: openssl rand -hex 32
# Required by the supplied Docker Compose deployment; Compose will refuse to
# start if this remains empty.
OPENETR_APP_SESSION_SECRET=

# Optional public and protocol configuration.
# OPENETR_PUBLIC_BASE_URL=https://openetr.example.org
# OPENETR_ROOT_NSEC=
# OPENETR_HOME_RELAYS=wss://relay.example.org
# Record-query relays, independent of home/bootstrap and publication relays.
# OPENETR_QUERY_RELAYS=wss://relay.openetr.org,wss://relay.example.org
# OPENETR_BLOSSOM_SERVER=https://blossom.example.org
# Upload pool overrides the single-server setting (comma or whitespace separated).
# Storage remains opt-in per upload; selected artifacts are sent to all these servers.
# OPENETR_BLOSSOM_SERVERS=https://blossom.example.org,https://backup.example.org
# Retrieval pool for public links and queries; defaults to the upload pool when unset.
# Resolution combines anchor hints, query servers, and upload servers in one pool.
# Verified anchor hints and per-query servers are retrieval-only candidates.
# OPENETR_BLOSSOM_QUERY_SERVERS=https://archive.example.org,https://blossom.example.org
# OPENETR_BLOSSOM_REQUIRE=any
# Values: any, half, majority, all. Publication stops if the threshold is not met.
# OPENETR_BLOSSOM_TIMEOUT_SECONDS=20
# OPENETR_BLOSSOM_OPERATION_TIMEOUT_SECONDS=60
# OPENETR_MAX_UPLOAD_BYTES=10485760
# OPENETR_GIT_COMMIT=unknown
